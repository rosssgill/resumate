# Copy to .env and fill in what you need. Real environment variables take priority.

# Model for `coach`, as a pydantic-ai model string (provider:model-name)
RESUMATE_MODEL=anthropic:claude-sonnet-5-5

# Provider settings, read by pydantic-ai. Only set the ones you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# Compile defaults
RESUMATE_PAPER=a4
RESUMATE_MAX_PAGES=1
RESUMATE_DEFAULT_FONT_SIZE=11
RESUMATE_MIN_FONT_SIZE=10
RESUMATE_FONT_SIZE_STEP=0.25
